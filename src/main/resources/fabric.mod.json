	"authors": [
		"AnnoyingVillager",
		"OneScreen contributors"
	],
	"license": "MIT",
	"icon": "assets/onescreen/icon.png",
	"contact": {
		"homepage": "https://github.com/AnnoyingVillager/onescreen",
		"sources": "https://github.com/AnnoyingVillager/onescreen",
		"issues": "https://github.com/AnnoyingVillager/onescreen/issues"
	},
	"environment": "*",
